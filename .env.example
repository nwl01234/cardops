# Copy to .env. Never commit the real .env. Generate: openssl rand -base64 48
NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Local demo Postgres is started automatically by `npm run demo`.
DATABASE_URL=postgres://cardops:cardops@localhost:55432/cardops
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
NOTIFICATIONS_PORT=8790
SCAN_PORT=8791
DOCUMENTS_PORT=8792
OCR_RATE_LIMIT=10
OCR_RATE_WINDOW_SECONDS=60

# MinIO/S3-compatible object storage for generated acts.
DOCUMENTS_URL=http://127.0.0.1:8792
DOCUMENTS_INTERNAL_TOKEN=change-me-openssl-rand-base64-48
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
S3_BUCKET=cardops-documents

WEB_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIE=false
TRUST_PROXY=true
SEED_DEMO=true
LOG_LEVEL=info

OUTBOX_POLL_MS=1000
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
APP_VERSION=0.1.0
