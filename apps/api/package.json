{
  "name": "@cardops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cardops/shared": "0.1.0",
    "@hono/node-server": "2.1.11",
    "@hono/node-ws": "1.3.2",
    "@node-rs/argon2": "2.2.2",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "ioredis": "5.9.2",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
