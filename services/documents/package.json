{
  "name": "@cardops/documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cardops/shared": "0.1.0",
    "@hono/node-server": "2.1.11",
    "@pdf-lib/fontkit": "1.1.1",
    "dotenv": "17.2.3",
    "hono": "4.13.19",
    "minio": "8.0.6",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
