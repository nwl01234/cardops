{
  "name": "@cardops/scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cardops/shared": "0.1.0",
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "ioredis": "5.9.2",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "tesseract.js": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
